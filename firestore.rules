rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['url', 'storagePath', 'fileName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['url', 'storagePath', 'fileName', 'createdAt'])
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://firebasestorage.googleapis.com/.*')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('birthday-photos/[^/]+')
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}